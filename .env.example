# Variables para la pestaña Environment del Compose "shlink" en Dokploy.
# Valores reales: Digital_ICON/SECRETS.txt. No subir valores reales al repo.

DB_PASSWORD=
# API key de Shlink (la usa también el panel). Ej: openssl rand -hex 24
API_KEY=
# Clave de licencia de MaxMind (GeoLite2), la misma de la prueba en KVM1
GEOLITE_LICENSE_KEY=
# htpasswd (usuario:hash) ENTRE COMILLAS SIMPLES: el hash lleva $ y compose los interpreta
# APP_BASIC_AUTH='admin:$apr1$...'
APP_BASIC_AUTH=
# Opcionales (vacío = 404)
BASE_URL_REDIRECT=
INVALID_URL_REDIRECT=
